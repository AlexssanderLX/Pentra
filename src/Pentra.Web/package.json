{
  "name": "pentra-web",
  "private": true,
  "version": "1.0.0",
  "description": "Tailwind CSS build pipeline for the Pentra web UI.",
  "scripts": {
    "css:build": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify",
    "css:watch": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
