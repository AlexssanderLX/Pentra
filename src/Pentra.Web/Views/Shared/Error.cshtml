@model Pentra.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card card-pad max-w-xl">
    <h1 class="text-xl text-red-300">Something went wrong</h1>
    <p class="mt-2 text-sm text-muted">An unexpected error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-3 font-mono text-xs text-muted">Request ID: @Model.RequestId</p>
    }
    <a class="btn-primary mt-5" asp-controller="Home" asp-action="Index">Back to dashboard</a>
</div>
